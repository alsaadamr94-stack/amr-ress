# ===== مطلوب =====
# رابط قاعدة Neon (استخدم الرابط الـ pooled) مثال:
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# مفتاح توقيع الجلسات، 32 حرفاً على الأقل. ولّده بالأمر: openssl rand -base64 48
AUTH_SECRET=
# رابط الموقع النهائي (يُستخدم في روابط البريد وروابط اعتماد العميل)
APP_URL=https://your-app.vercel.app
# مفتاح إنشاء أول مدير (يُطلب مرة واحدة في صفحة /setup)
SETUP_KEY=
# سر تشغيل المهام المجدولة (النسخ الاحتياطي والتقرير الشهري). يرسله Vercel تلقائياً
CRON_SECRET=

# ===== البريد (اختر واحداً) =====
# الخيار 1: SMTP (مثلاً Gmail مع App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# الخيار 2: Resend (يحتاج توثيق نطاق الإرسال)
RESEND_API_KEY=
MAIL_FROM="شركة رسس <no-reply@your-domain.com>"
